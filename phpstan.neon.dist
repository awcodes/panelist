includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    reportUnmatchedIgnoredErrors: false
    paths:
        - src
        - config
        - workbench
    excludePaths:
        analyse:
            - workbench/storage (?)
    tmpDir: build/phpstan
    ignoreErrors:
        # larastan narrows a string literal to view-string only when it can resolve
        # the view namespace. It does not resolve this package's own `panelist::`
        # namespace outside a booted app (same exception as curator).
        - identifier: argument.type
          message: '#expects view\-string#'
